# 🌸 Yumi Bot — Archivo de ejemplo .env
# Copia este archivo como ".env" y rellena con tus datos.

# Token del bot de Discord
DISCORD_TOKEN=tu_token_aqui

# ID del cliente (bot)
CLIENT_ID=1249418453131984939

# Prefijo opcional (si usas comandos legacy además de slash)
PREFIX=/

# URL de MongoDB para la base de datos
MONGO_URI=mongodb://localhost:27017/yumi

# ID de desarrollador principal (para comandos restringidos)
DEV_ID=819080793447333918

# Canal de logs (opcional, si quieres enviar errores globales)
LOG_CHANNEL_ID=1290516437533986891
